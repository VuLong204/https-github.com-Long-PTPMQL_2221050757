﻿@{
    ViewData["Title"] = "Quản lý trạng thái MVC";
}

<div class="hero-card mb-4">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-primary mb-3">ASP.NET CORE MVC</span>
            <h1 class="display-5 fw-bold">Quản lý trạng thái trong MVC</h1>
            <p class="lead">Tìm hiểu và thực hành <strong>ViewBag</strong>, <strong>ViewData</strong> và <strong>TempData</strong>.</p>
            <p class="mb-0"><strong>Sinh viên:</strong> @ViewBag.HoTen &nbsp;|&nbsp; <strong>MSSV:</strong> @ViewBag.Mssv</p>
        </div>
        <div class="col-lg-4 text-center mt-4 mt-lg-0">
            <div class="state-icon">MVC</div>
        </div>
    </div>
</div>

<div class="alert alert-info">
    <strong>Chủ đề:</strong> @ViewData["ChuDe"]
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm state-card">
            <div class="card-body">
                <h3>ViewBag</h3>
                <p>Truyền dữ liệu động từ Controller sang View bằng thuộc tính.</p>
                <a asp-action="ViewBagDemo" class="btn btn-primary">Xem demo</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm state-card">
            <div class="card-body">
                <h3>ViewData</h3>
                <p>Lưu dữ liệu dạng key-value để truyền từ Controller sang View.</p>
                <a asp-action="ViewDataDemo" class="btn btn-success">Xem demo</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm state-card">
            <div class="card-body">
                <h3>TempData</h3>
                <p>Truyền dữ liệu giữa các request, rất phù hợp sau Redirect.</p>
                <a asp-action="GuiTempData" class="btn btn-warning">Chạy demo</a>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4 shadow-sm">
    <div class="card-body">
        <h4>Student Demo</h4>
        <p>Phần thực hành form Student vẫn được giữ lại từ project gốc.</p>
        <a asp-controller="Student" asp-action="Index" class="btn btn-outline-dark">Mở Student</a>
    </div>
</div>
