﻿@{
    ViewData["Title"] = "Demo ViewBag";
}
<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="text-primary">@ViewBag.TieuDe</h1>
        <hr />
        <p><strong>Họ tên:</strong> @ViewBag.HoTen</p>
        <p><strong>MSSV:</strong> @ViewBag.Mssv</p>
        <p><strong>Lớp:</strong> @ViewBag.Lop</p>
        <div class="alert alert-primary mb-0">Dữ liệu được tạo trong <code>HomeController</code> và hiển thị bằng ViewBag.</div>
    </div>
</div>
